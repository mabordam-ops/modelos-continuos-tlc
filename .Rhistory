#| echo: false
#| message: false
#| warning: false
library(ggplot2)
library(dplyr)
# 1. Preparar los datos calculando los porcentajes
df_pie <- educacion %>%
group_by(Genero) %>%
summarise(n = n()) %>%
mutate(pct = n / sum(n),
label = paste0(round(pct * 100, 1), "%"))
# 2. Crear el gráfico circular
ggplot(df_pie, aes(x = "", y = n, fill = Genero)) +
geom_bar(stat = "identity", width = 1) +
coord_polar("y", start = 0) +
theme_void() + # Quita el fondo y los ejes para que sea un círculo limpio
scale_fill_manual(values = c("Femenino" = "#F8766D", "Masculino" = "#00BFC4")) +
geom_text(aes(label = label),
position = position_stack(vjust = 0.5),
color = "white",
size = 5) +
labs(title = "Distribución porcentual del genero de los encuestados",
fill = "GENERO") +
theme(plot.title = element_text(hjust = 0.5, size = 14))
