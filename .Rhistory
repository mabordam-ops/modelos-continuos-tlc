library(janitor)
library(dplyr)
library(knitr)
library(ggplot2)
# Crear la tabla UNA SOLA VEZ
tabla_genero <- educacion %>%
tabyl(Genero) %>%
adorn_totals("row") %>%
adorn_pct_formatting(digits = 1)
# Renombrar columnas
colnames(tabla_genero) <- c("Género", "Frec. Absoluta (n)", "Porcentaje (%)")
# Mostrar tabla estética
kable(tabla_genero, align = "c", caption = "Tabla 1: Distribución de Género")
#| echo: false
ggplot(educacion, aes(x = Genero, fill = Genero)) +
geom_bar() +
labs(title = "Gráfico de Barras: Género",
x = "Género", y = "Frecuencia") +
theme_minimal() +
scale_fill_brewer(palette = "Pastel1") +
theme(legend.position = "none")
