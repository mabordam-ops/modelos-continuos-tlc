install.packages("janitor")
#| label: tabla-nominal-genero
#| message: false
library(janitor)
library(dplyr)
# Creamos la tabla con Frecuencia Absoluta, Relativa y Porcentaje
tabla_genero <- educacion %>%
tabyl(Genero) %>%
adorn_totals("row") %>%           # Añade la fila de "Total"
adorn_pct_formatting(digits = 1)  # Convierte la frecuencia relativa a % bonito
# Cambiamos los nombres para que se vea profesional en el informe
colnames(tabla_genero) <- c("Género", "Frec. Absoluta (n)", "Frec. Relativa (h)", "Porcentaje (%)")
```{r}
#| label: tabla-nominal-corregida
#| message: false
#| warning: false
library(janitor)
library(dplyr)
library(knitr)
# 1. Crear la tabla (Esto genera 3 columnas por defecto)
tabla_genero <- educacion %>%
tabyl(Genero) %>%
adorn_totals("row") %>%
adorn_pct_formatting(digits = 1)
# 2. RENOMBRAR (Solo usamos 3 nombres porque janitor dio 3 columnas)
# Si quieres la columna "Frecuencia Relativa (decimal)", hay que crearla antes.
colnames(tabla_genero) <- c("Género", "Frec. Absoluta (n)", "Porcentaje (%)")
# 3. Mostrar con formato profesional
kable(tabla_genero,
align = "c",
caption = "Tabla 1: Distribución de Frecuencias para Variable Nominal")
#| echo: false
#| message: false
library(janitor)
library(dplyr)
library(knitr)
# Crear la tabla
tabla_genero <- educacion %>%
tabyl(Genero) %>%
mutate(frec_relativa = n / sum(n)) %>%
select(Genero, n, frec_relativa, percent) %>%
adorn_totals("row") %>%
adorn_pct_formatting(digits = 1)
